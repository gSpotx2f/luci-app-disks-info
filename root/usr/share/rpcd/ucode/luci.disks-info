
'use strict';

import { basename, dirname, lsdir, popen, readfile, readlink, stat } from 'fs';

const fdiskPattern = '/usr/sbin/fdisk -lo Device,Start,End,Sectors,Size,Type %s 2> /dev/null';
const dfPattern    = '/bin/df -PTh %s 2> /dev/null';
const deviceRegexp = /^((h|s)d[a-z]|nvme[0-9]+n[0-9]+)$/;
const devicesDir   = '/dev';

function getCmdOutput(cmd) {
	let ret  = '';
	const fp = popen(cmd, 'r');
	if(fp) {
		let c = fp.read('all');
		fp.close();
		if(c) {
			ret = trim(c);
		}
	}
	return ret;
}

function getDiskDevices() {
	let devices = lsdir(devicesDir);
	if(devices) {
		devices = map(
			filter(devices, e => match(e, deviceRegexp)),
			e => devicesDir + '/' + e
		);
	}
	return devices ?? [];
}

function getFdiskData(device) {
	let diskDict   = {};
	let diskInfo   = [];
	let partitions = [];
	let output     = getCmdOutput(sprintf(fdiskPattern, device));
	let diskData   = map(
		split(trim(output), '\n\n', 3),
		e => trim(e)
	);
	if(length(diskData) > 0) {
		diskInfo = map(
			map(split(diskData[0], '\n'), e => trim(e)),
			e => map(split(e, ':', 2), e => trim(e))
		);
		if(diskData[1]) {
			let partitionsRaw = map(split(diskData[1], '\n'), e => split(e, /\s+/));
			for(let i = 1; i < length(partitionsRaw); i++) {
				let device, boot = false, start, end, sectors, size;
				let lastField = 5;
				if(partitionsRaw[i][1] == '*') {
					lastField = 6;
					device    = partitionsRaw[i][0];
					boot      = true;
					start     = partitionsRaw[i][2];
					end       = partitionsRaw[i][3];
					sectors   = partitionsRaw[i][4];
					size      = partitionsRaw[i][5];
				} else {
					device  = partitionsRaw[i][0];
					start   = partitionsRaw[i][1];
					end     = partitionsRaw[i][2];
					sectors = partitionsRaw[i][3];
					size    = partitionsRaw[i][4];
				}
				let type = [];
				for(let j = lastField; j < length(partitionsRaw[i]); j++) {
					push(type, partitionsRaw[i][j]);
				}
				push(partitions, { device, boot, start, end, sectors, size, type: join(' ', type) });
			}
		}
	}
	diskDict['diskInfo']   = diskInfo;
	diskDict['partitions'] = partitions;
	return diskDict;
}

function unescapeMountPath(path) {
	return replace(path, /\\(040|011|012|134)/g,
		(_, octal) => sprintf('%c', int(octal, 8)));
}

function getSourceDevice(source) {
	let info = stat(source);
	if(!info || info.type != 'block') {
		return '';
	}
	// Resolve aliases using APIs available in OpenWrt 22.03's ucode.
	for(let i = 0; i < 40; i++) {
		let target = readlink(source);
		if(target == null) {
			return trim(readfile('/sys/class/block/' + basename(source) + '/dev') ?? '');
		}
		source = (substr(target, 0, 1) == '/' ? '' : dirname(source) + '/') + target;
	}
	return '';
}

function getMounts() {
	let mounts = [];
	for(let line in split(readfile('/proc/self/mountinfo') ?? '', '\n')) {
		let fields = split(line, ' - ', 2);
		if(length(fields) != 2) {
			continue;
		}
		let info = split(fields[0], ' ');
		let fs = split(fields[1], ' ');
		let filesystem = unescapeMountPath(fs[1]);
		// Btrfs subvolumes report an anonymous device number in mountinfo.
		let sourceDevice = match(info[2], /^0:/) ? getSourceDevice(filesystem) : '';
		push(mounts, {
			device: info[2],
			sourceDevice,
			mounted: unescapeMountPath(info[4]),
			type: fs[0],
			filesystem,
		});
	}
	return mounts;
}

function getBlockDevices(device, devices) {
	let path = '/sys/class/block/' + device;
	let id = trim(readfile(path + '/dev') ?? '');
	if(!id || devices[id]) {
		return;
	}
	devices[id] = true;

	// Follow consumers, e.g. sda3 -> md2 -> dm-0, without visiting siblings.
	for(let holder in lsdir(path + '/holders') ?? []) {
		getBlockDevices(holder, devices);
	}
	// Whole disks and arrays may both contain partitions.
	for(let child in lsdir(path) ?? []) {
		if(readfile(path + '/' + child + '/partition') != null) {
			getBlockDevices(child, devices);
		}
	}
}

function isCurrentMount(mount) {
	let info = stat(mount.mounted);
	return info && sprintf('%d:%d', info.dev.major, info.dev.minor) == mount.device;
}

function getDfData(mount) {
	let fsDict = {};
	// A mount may be hidden or removed after reading mountinfo.
	if(!isCurrentMount(mount)) {
		return fsDict;
	}
	let quotedPath = "'" + replace(mount.mounted, /'/g, "'\\''") + "'";
	let output = getCmdOutput(sprintf(dfPattern, quotedPath));
	if(!isCurrentMount(mount)) {
		return fsDict;
	}
	let fsData = map(
		split(trim(output), '\n'),
		e => trim(e)
	);
	// Match the usage columns even when the filesystem name contains spaces.
	let stats = match(fsData[1] ?? '', /\s+\S+\s+(\S+)\s+(\S+)\s+(\S+)\s+([0-9]+%)[ \t]+\//);
	if(stats) {
		fsDict['filesystem'] = mount.filesystem;
		fsDict['type']       = mount.type;
		fsDict['size']       = stats[1];
		fsDict['used']       = stats[2];
		fsDict['available']  = stats[3];
		fsDict['use_perc']   = stats[4];
		fsDict['mounted']    = mount.mounted;
	}
	return fsDict;
}

const methods = {
	getDevices: {
		call: function() {
			let data      = {};
			const devices = getDiskDevices();
			if(length(devices) > 0) {
				let fdiskData = {};
				for(let i in devices) {
					fdiskData[i] = getFdiskData(i);
				}
				let dfData = {};
				let mounts = getMounts();
				let dfCache = {};
				for(let k in fdiskData) {
					let filesystems = [];
					let blockDevices = {};
					getBlockDevices(substr(k, length(devicesDir) + 1), blockDevices);
					for(let mount in mounts) {
						if(!blockDevices[mount.device] && !blockDevices[mount.sourceDevice]) {
							continue;
						}
						let cacheKey = mount.device + ' ' + mount.mounted;
						let res = dfCache[cacheKey];
						if(res == null) {
							res = dfCache[cacheKey] = getDfData(mount);
						}
						if(length(res) > 0) {
							push(filesystems, res);
						}
					}
					dfData[k] = filesystems;
				}
				data['devices'] = () => {
					let d = [];
					for(let k in fdiskData) {
						push(d, k);
					}
					return d;
				}();
				data['fdisk'] = fdiskData;
				data['df']    = dfData;
			}
			return data;
		}
	}
};

return { 'luci.disks-info': methods };
